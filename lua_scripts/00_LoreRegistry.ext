-- ============================================================
-- Azeroth: Эхо Пустоты (Azeroth Custom Realm)
-- 00_LoreRegistry.ext
-- Назначение: ЕДИНЫЙ ИСТОЧНИК ПРАВДЫ для лора реалма.
-- Потребители:
--   PortalGuardian.lua   — НПС «Портальный Страж» (70001)
--   LoreArchive.lua      — НПС «Хронист Ордена» (70180)
--   AddonBridge.lua      — отправка лора в аддон AzerothEcho (prefix AECHOLORE)
--   addons/AzerothEcho   — вкладка «Лор»
--
-- РАСШИРЕНИЕ .ext ОБЯЗАТЕЛЬНО: движок ALE (mod-ale) грузит файлы
-- .ext до всех .lua независимо от имён, поэтому реестр гарантированно
-- доступен остальным скриптам.
--
-- Синхронизировано с docs/lore/universe.md. При правке лора
-- правится ЭТОТ файл и документ; PortalGuardian/LoreArchive/аддон
-- читают отсюда и текстов не дублируют.
--
-- Формат секции:
--   id        — машинный ключ (латиница, без пробелов)
--   title     — заголовок пункта меню
--   header    — строка-заголовок внутри страницы (необязательно)
--   lines     — массив строк страницы
--   min_stage — минимальная стадия истории (0 = видна сразу)
--   max_stage — максимальная стадия (nil = без ограничения)
--
-- Стадия истории игрока вычисляется по прогрессу кампаний
-- (см. function Lore.Stage(player) ниже): 0..5.
-- ============================================================

-- Цвета берём из основного реестра; если он ещё не загружен —
-- подставляем литералы (файл обязан работать и в изоляции).
local REG = AzerothEchoCampaigns
local COL = (REG and REG.meta and REG.meta.colors) or {}
local ORDER = COL.order or "|cff5dade2"
local VOID  = COL.void  or "|cff8e44ad"
local CULT  = COL.cult  or "|cffc0392b"
local TAG   = (REG and REG.meta and REG.meta.tag) or "|cff9b59b6[Эхо Пустоты]|r"

AzerothEchoLore = AzerothEchoLore or {}

local Lore = AzerothEchoLore

Lore.meta = {
    tag = TAG,
    colors = { order = ORDER, void = VOID, cult = CULT },
    -- Версия схемы: аддон сверяет её, чтобы не показывать устаревший кэш
    version = 2,
    -- Стадии истории и их человекочитаемые имена
    stages = {
        [0] = "Ожидание",
        [1] = "Пролог",
        [2] = "Эхо Шёпота",
        [3] = "Пепел Зул'Драка",
        [4] = "Пробуждение",
        [5] = "Второе Эхо",
    },
}

-- ============================================================
-- 1. ПРОЛОГ — что случилось до прихода героя
-- ============================================================
Lore.sections = {}
Lore.sections[#Lore.sections + 1] = {
    id = "prologue",
    title = "Что случилось с Азеротом?",
    header = ORDER .. "== Пролог: осколок трона ==",
    min_stage = 0,
    lines = {
        "Король-лич пал. Ледяная Корона раскололась, и её обломки разлетелись по Нордсколу.",
        "Самый крупный осколок — кусок трона Артаса — ушёл в землю " .. CULT .. "Драконьего Погоста|r.",
        "Там он пропитался тем, что в древних текстах называют " .. VOID .. "Пустотой|r. Камень начал " .. VOID .. "шептать|r.",
        "Первыми услышали маги: чародеи, жрецы, шаманы — все, чья воля касается ткани мира.",
        "Одни записывали шёпот в дневники. Другие бросали семьи и уходили на север. Третьи не просыпались.",
        "Так родилась эта временная линия: мир, который не успел оправиться от одного конца света, прежде чем начался следующий.",
    },
}

Lore.sections[#Lore.sections + 1] = {
    id = "whisper",
    title = "Что такое Шёпот?",
    header = ORDER .. "== Шёпот: голос из камня ==",
    min_stage = 0,
    lines = {
        "Шёпот — не слово и не мысль. Это " .. VOID .. "давление|r на разум, которое разум переводит в слова.",
        "Каждый слышит своё: воин — грохот битвы, жрец — молитву, маг — формулу, которой не учил.",
        "Он не приказывает. Он " .. VOID .. "обещает|r: силу, понимание, память о погибших, ответ на вопрос, который ты боишься задать.",
        "Чем ближе к разлому, тем громче. В эпицентре шёпот перестаёт быть звуком и становится погодой.",
        "Орден Рассвета установил три правила обращения с ним: не отвечать вслух, не записывать дословно, не оставаться наедине больше часа.",
    },
}

Lore.sections[#Lore.sections + 1] = {
    id = "void_nature",
    title = "Пустота: что она делает с живыми?",
    header = ORDER .. "== Пустота: правила, а не метафора ==",
    min_stage = 0,
    lines = {
        "Пустота не убивает. Убийство — это её " .. VOID .. "ошибка|r, брак в работе.",
        "Она " .. VOID .. "иссушает|r: вынимает волю, оставляя тело, память и привычки. Получается Иссушенный — оболочка, которая помнит свою жизнь, но не владеет ею.",
        "Иссушенный узнаёт родных, здоровается, идёт знакомой дорогой — и при этом может убить, потому что так велит шёпот.",
        "Рядом с разломом магия ведёт себя иначе: заклинания срываются, ауры множатся, исцеление работает медленнее. Это не сбой — это чужая логика, навязанная миру.",
        "Поэтому Орден воюет не с армией, а с " .. VOID .. "местом|r. Убить Иссушенных можно, но пока цел разлом — на их место придут новые.",
    },
}

Lore.sections[#Lore.sections + 1] = {
    id = "gesalt",
    title = "Осколок Трона и Усмешка Бездны",
    header = ORDER .. "== Осколок Трона ==",
    min_stage = 0,
    lines = {
        "Внутри осколка спит не Старый Бог — лишь " .. VOID .. "осколок его сознания|r, застрявший в камне, как сон в голове спящего.",
        "Его называют " .. VOID .. "Усмешкой Бездны|r. Имя дано за то, как меняется шёпот, когда он близок к пробуждению: он начинает звучать как смех.",
        "Разбудить Усмешку можно только ритуалом — долгим, требующим крови, очагов и смерти тех, кто дал согласие.",
        "Культ Усмешки Бездны убеждён: пробуждение — это " .. CULT .. "очищение|r. Мир, который не смог удержать себя, должен быть переписан изнутри.",
        "Орден убеждён в обратном: даже осколок спящего разума, разбуженный, не вернётся обратно в сон.",
    },
}

-- ============================================================
-- 2. ФРАКЦИИ
-- ============================================================
Lore.sections[#Lore.sections + 1] = {
    id = "order",
    title = "Орден Рассвета",
    header = ORDER .. "== Орден Рассвета ==",
    min_stage = 0,
    lines = {
        "Коалиция Альянса и Орды, созданная после падения Короля-лича. Штаб — " .. ORDER .. "Даларан|r, город, который не принадлежит никому и потому годится всем.",
        "Формально Орден — разведывательная и спасательная структура. Фактически — единственная сила, которая действует там, где разлом уже открылся.",
        "Члены Ордена не дают присяги короне. Они дают присягу " .. ORDER .. "агентам рядом|r: не оставлять своих, не отвечать шёпоту, докладывать всё.",
        "Командование разделено намеренно: разведка (Элианна), полевые операции (Валирия), дипломатия (Мортег). Никто не держит всю картину — чтобы шёпот не получил её целиком из одного разума.",
        "Ты — новый агент. Именно поэтому тебе рассказывают это сейчас, а не после первой вылазки.",
    },
}

Lore.sections[#Lore.sections + 1] = {
    id = "cult",
    title = "Культ Усмешки Бездны",
    header = CULT .. "== Культ Усмешки Бездны ==",
    min_stage = 0,
    lines = {
        "Не единая церковь, а " .. CULT .. "сеть кружков|r: в каждом свой ритуал, свой лидер, свой вариант учения. Общее одно — они слышат шёпот и считают его приглашением.",
        "Центральная фигура — " .. VOID .. "Пророк Нал'кур|r. Он говорит от имени Усмешки и обещает своим последователям место в «переписанном мире».",
        "Культ вербует не безумцев. Он вербует " .. CULT .. "уставших|r: тех, кто потерял семью, дом или веру.",
        "Они не считают себя злодеями. В их понимании мир уже мёртв — и они лишь помогают ему перестать притворяться.",
        "Базы: " .. CULT .. "Драконий Погост|r, " .. CULT .. "Зул'Драк|r, тайные склады в Бесплодных землях, перевал на Острове Морза и сборный лагерь в Долине Предательства.",
    },
}

Lore.sections[#Lore.sections + 1] = {
    id = "warders",
    title = "Стражи Пустоты",
    header = VOID .. "== Стражи Пустоты ==",
    min_stage = 0,
    lines = {
        "Драконы всех полётов, объединённые не дружбой, а " .. VOID .. "общим страхом|r.",
        "Они видели, как Пустота входила в мир раньше. Каждый полёт помнит своё поражение.",
        "К смертным Стражи относятся настороженно: смертные слушают шёпот, значит, могут стать его рукой.",
        "Союз с ними не заключается договором — он " .. VOID .. "зарабатывается|r доказательствами. Первый шаг — пройти испытание Сквернозора.",
        "Хранительница " .. VOID .. "Аэрис|r — их голос для Ордена. Она говорит редко и никогда не повторяет дважды.",

    -- ========================================================
    -- Ивент «Разломы Пустоты» (17_TimeRift.lua; адаптация
    -- eluna-scripts/Time Rift): раз в interval_secs в случайной
    -- точке Драконьего Погоста открывается портал (70190),
    -- из которого идут волны Иссушенных (70191). Убийство моба
    -- спавнит следующего, пока портал жив. Награда — Жетон Эха.
    -- ========================================================
    time_rift = {
        enabled = true,
        interval_secs = 45 * 60,    -- раз в 45 мин

-- Счётчик кампаний — динамический, чтобы print не расходился с реестром
local campaignCount = 0
for _ in pairs(AzerothEchoCampaigns.campaigns) do campaignCount = campaignCount + 1 end
print("[EchoOfTheVoid] 00_CampaignRegistry.ext загружен (реестр кампаний: " .. campaignCount .. " кампаний).")

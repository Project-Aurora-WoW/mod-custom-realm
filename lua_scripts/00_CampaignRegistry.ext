    -- ========================================================
    -- Баланс реалма (Lua-часть; C++-мультипликаторы в
    -- modules/echo-balance, конфиг echo-balance.conf)
    -- Синхронизировано с модулем echo-balance: значения по умолчанию
    -- должны совпадать с conf-файлом.
    -- ========================================================
    balance = {
        -- Кампании: награда за главу (только для главы с наградой)
        campaign_chapter_tokens = 0,       -- жетонов за промежуточную главу (0 = выкл)
        campaign_completion_tokens = 3,    -- жетонов за завершение любой кампании

        -- Ивенты
        event_elite_token_bonus = 1,       -- доп. жетон за убийство элиты ивента 80+

        -- PvP
        pvp_streak_token_bonus = {         -- доп. жетоны за серию киллов (порог -> бонус)
            [5] = 1,
            [10] = 2,
        },

        -- Мирный урон (защита стартовых зон и мирных НПС логикой ядра)
        world_damage_scalar = 1.0,         -- глобальный множитель урона мобов (C++-модуль)

        -- Ивентовые элиты (спавнятся EventSystem на высоких волнах)
        elite_scale_health = 2.0,          -- HP элиты = base * scalar
        elite_scale_damage = 1.5,          -- урон элиты = base * scalar
        elite_wave_threshold = 3,          -- с какой волны начинается элита
    },


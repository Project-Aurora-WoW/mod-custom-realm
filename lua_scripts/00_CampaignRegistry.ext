-- ============================================================
-- Azeroth: Эхо Пустоты (Azeroth Custom Realm)
-- 00_CampaignRegistry.ext
-- Назначение: центральный реестр кампаний реалма.
-- Единый источник правды для Campaign1/2/3.lua и AddonBridge.lua:
-- названия кампаний, число глав, требуемые токены, entry НПС,
-- награды, общие текстовые константы.
-- РАСШИРЕНИЕ .ext ОБЯЗАТЕЛЬНО: движок ALE (mod-ale) грузит файлы
-- .ext до всех .lua независимо от имён, реестр гарантированно
-- доступен остальным скриптам. (В стоковом Eluna порядок
-- алфавитный — префикс 00_ сохранён для совместимости.)
-- Данные синхронизированы с docs/campaigns/README.md и
-- sql/world/*.sql (entry НПС/предметов).
-- ============================================================

AzerothEchoCampaigns = {
    -- ========================================================
    -- Утилиты (грузится первым — .ext до всех .lua)
    -- ========================================================
    -- Экранирование строковых значений для вставки в SQL
    -- (CharDBQuery/CharDBExecute не параметризуются в ALE — защита
    --  от SQL-инъекций через имена игроков/свободный текст).
    escape = function(s)
        if not s then return "" end
        return tostring(s):gsub("'", "''"):gsub("\\", "\\\\")
    end,

    -- Общие константы реалма
    meta = {
        prefix = "AECHO",                       -- префикс аддон-сообщений
        tag = "|cff9b59b6[Эхо Пустоты]|r",      -- тег чата
        -- Источник команд .ae/.aecampaign (синхронизирован с
        -- modules/echo-campaigns/conf/echo-campaigns.conf.dist):
        -- "lua" | "core" | "both". При "core" Lua-обработчик пропускает
        -- команды, их обрабатывает C++-модуль в ядре.
        command_source = "lua",
        colors = {
            order = "|cff5dade2",               -- Орден Рассвета
            void = "|cff8e44ad",                -- Пустота
            cult = "|cffc0392b",                -- Культ Усмешки Бездны
        },
        db_table = "realm_campaign_progress",   -- таблица прогресса
        whisper_aura = 33757,                   -- дебафф «Эхо Шёпота» (Драконий Погост)
        dragonblight_zone = 4080,               -- zoneId Драконьего Погоста
        min_level = 80,                         -- минимальный уровень для кампаний (гейт)
        token_item = 70005,                     -- «Жетон Эха» — валюта ивентов и PvP-зоны
    },

    -- Ивенты реалма (авто-расписание + GM-управление .aeevent)
    events = {
        -- Общая точка спавна: разлом в Драконьем Погосте
        rift = { map = 571, x = 3864.53, y = 6985.11, z = 146.11, o = 4.68 },

        storm = {
            key = "storm",
            name = "Шторм Пустоты",
            interval_secs = 3 * 3600,   -- каждые 3 часа
            duration_secs = 30 * 60,    -- 30 минут
            mob_entry = 70100,          -- Ахерон-Пустотники
            mob_count = 10,             -- волна при старте
            token_reward = 1,           -- жетонов за моба во время шторма
        },
        blood = {
            key = "blood",
            name = "Кровавая Луна Культа",
            interval_secs = 6 * 3600,   -- каждые 6 часов (со сдвигом старта)
            duration_secs = 60 * 60,    -- 1 час
            mob_entry = 70101,          -- Культисты усилены (лор: +50% ярости)

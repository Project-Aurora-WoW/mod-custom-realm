        },
    },

    -- PvP-система (.aepvp)
    pvp = {
        min_level_diff = 10,        -- анти-абюз: разница уровней киллер/жертва
        farm_cooldown_secs = 300,   -- 5 мин между киллами одной пары
        streak_announce = { [3] = "несёт Эхо через поле боя!", [5] = "Шёпот боится его клинка!", [10] = "ЛЕГЕНДА ПОЛЯ БОЯ!" },
        zone_token_kill = 1,        -- жетонов за килл в PvP-зоне (Драконий Погост)
    },

    -- Глобальный мировой чат (09_WorldChat.lua, адаптация
    -- waloriaold/scripts/worldchat.lua): игрок включает канал командой
    -- .chat on и всё, что он пишет в /say, уходит всему реалму.
    worldchat = {
        channel = "Эхо Пустоты",    -- имя канала в сообщениях
        cooldown_secs = 5,          -- антиспам: сек между сообщениями игрока
        command_on = ".chat on",    -- включить мировой чат
        command_off = ".chat off",  -- выключить мировой чат
    },


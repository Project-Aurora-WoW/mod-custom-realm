#
# echo-attune — конфиг модуля «Аттюнмент Мировой Души»
# Параллельная кампания «Мировая Душа» (см. sql/world/0041_echo_worldsoul.sql).
#
# Пер-предметный аттюнмент: предмет, надетый персонажем, накапливает
# прогресс во время боя. Прогресс хранится по item-guid в realm_echo_attune
# (acore_characters) и читается Lua-скриптом 39_EchoWorldsoul.lua.
#

# Включить модуль.
EchoAttune.Enable = 1

# Минимальный уровень для накопления аттюнмента (совпадает с гейтом кампании).
EchoAttune.MinLevel = 80

# Сколько «единиц прогресса» даёт секунда боя (прирост за тик).
EchoAttune.ProgressPerSecond = 2

# Порог прогресса для полного аттюнмента (max_prog в таблице).
EchoAttune.MaxProgress = 1000

# Верхняя граница записей аттюнмента на одного игрока (защита от мусора).
EchoAttune.MaxAttunedPerPlayer = 200

# Период записи в БД (мс). Аттюнмент копит в памяти и сбрасывает пакетами.
EchoAttune.FlushIntervalMs = 30000
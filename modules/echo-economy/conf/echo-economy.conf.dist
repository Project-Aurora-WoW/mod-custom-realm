-- ============================================================
-- echo-economy — конфигурационный файл (dist)
-- C++-модуль экономики реалма «Эхо Пустоты» (анти-инфляция).
-- Лор: «Пустота забираёт своё» — жетоны, скопленные в избытке,
-- истаивают, как эхо без камня.
-- ============================================================

[echo-economy]

# Включение модуля.
EchoEconomy.Enable = 1

# Entry валюты реалма (Жетон Эха).
EchoEconomy.TokenItem = 70005

# Мягкий лимит жетонов на персонаже. При входе в мир всё, что
# сверх лимита, урезается на DrainPercent% (см. ниже).
EchoEconomy.TokenCap = 50

# Доля (%) избытка, забираемая Пустотой при входе (0–100).
# 100 = весь избыток изымается, 50 = половина.
EchoEconomy.DrainPercent = 50

# Сообщать игроку о сливе (0 = молча).
EchoEconomy.AnnounceDrain = 1

# ------------------------------------------------------------
# Outbox-доставка наград (паттерн wow-mod-delves: durable intent
# + receipts). Миграция: sql/world/0015_token_outbox.sql.
# ------------------------------------------------------------
# Включение отложенной выдачи жетонов через realm_token_outbox.
EchoEconomy.Outbox.Enable = 1

# Максимум недоставленных наград на одну доставку игрока
# (при входе).
EchoEconomy.Outbox.BatchSize = 5

-- ============================================================
-- echo-startup — конфигурационный файл (dist)
-- C++-модуль стартового набора реалма «Эхо Пустоты».
-- Лор: Орден Рассвета снабжает каждого новичка перед первой
-- встречей с Пустотой.
-- ============================================================

[echo-startup]

# Включение модуля.
EchoStartup.Enable = 1

# Максимальное игровое время персонажа (сек), при котором он
# считается новичком и получает набор (детект первого входа:
# played time свежего персонажа — секунды).
EchoStartup.NewbieMaxPlayedTimeSecs = 60

# Минимальный уровень персонажа для выдачи набора (0 = любой).
EchoStartup.MinLevel = 0

# Стартовые предметы: entry:count через запятую.
# 6948 «Слеза Ашканди» не используется; набор — расходники
# и сигнальный предмет Ордена.
# 33470 рунное зелье исцеления, 33475 рунное зелье маны,
# 43005 рунные полоски мяса (еда), 69237 Турбо-скудохранитель
# не выдаём (косметика шопа) — вместо него 70005 Жетон Эха x2,
# чтобы новичок попробовал экономику реалма.
EchoStartup.Items = 33470:3,33475:3,43005:5,70005:2

# Бафф «Напутствие Ордена» (spell 58452 — ритуал благословения,
# стоковый бафф +10% к характеристикам на 1 час) при первом входе.
# 0 = без баффа.
EchoStartup.BuffSpell = 58452

-- ============================================================
-- echo-pve — конфигурационный файл (dist)
-- C++-модуль PvE-механик Пустоты реалма «Эхо Пустоты».
-- Значения по умолчанию синхронизированы с
-- lua_scripts/00_CampaignRegistry.lua (events/balance).
-- ============================================================

[echo-pve]

# Включение модуля.
EchoPve.Enable = 1

# Лор: «ночью шёпот громче». Ночью (18:00–06:00 игрового времени)
# урон порождений Пустоты (entry из списка ниже) умножается
# на этот множитель (сверху EchoBalance.WorldDamageScalar).
EchoPve.NightDamageScalar = 1.25

# Начало/конец ночного окна (часы игрового времени, 0–23).
EchoPve.NightStartHour = 18
EchoPve.NightEndHour = 6

# Entry порождений Пустоты, к которым применяется ночной множитель
# (через запятую). 70100 Ахерон-Пустотник, 70101 Культист,
# 70105 Пустотный Страж, 70201 Осколочный Фантом,
# 70202 Иссушенный Легионер, 70500/70510/70520 — боссы кампаний.
EchoPve.VoidCreatures = 70100,70101,70105,70201,70202,70500,70510,70520

# Шанс (%) выпадения Жетона Эха (item 70005) с порождений Пустоты
# вне ивентов (ивентовая награда — в 10_EventSystem.lua).
# 0 = выкл.
EchoPve.TokenDropChance = 3

# Внутренний кулдаун выпадения жетона на игрока (сек) — анти-фарм.
EchoPve.TokenDropCooldownSecs = 600

# Пик ночи (22:00–04:00): дополнительный множитель поверх
# NightDamageScalar (профильный скейлинг по образцу wow-mod-delves
# MakeScaleProfile: сумерки → 1.0, ночь → NightDamageScalar,
# пик → NightDamageScalar × MidnightBonusScalar).
EchoPve.MidnightBonusScalar = 1.15

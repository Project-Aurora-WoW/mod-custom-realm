-- ============================================================
-- echo-balance — конфигурационный файл (dist)
-- C++-модуль баланса реалма «Эхо Пустоты».
-- Глобальные мультипликаторы урона/лечения применяются ядром
-- до расчёта урона; значения по умолчанию синхронизированы с
-- lua_scripts/00_CampaignRegistry.lua -> balance.
-- ============================================================

[echo-balance]

# Глобальный множитель урона, наносимого существами игрокам.
# 1.0 = канон; <1.0 — «казуальнее»; >1.0 — хардкорнее.
EchoBalance.WorldDamageScalar = 1.0

# Глобальный множитель исходящего урона игроков.
EchoBalance.PlayerDamageScalar = 1.0

# Глобальный множитель эффективности лечения.
EchoBalance.HealingScalar = 1.0

# Жёсткая отсечка урона: если существо наносит игроку больше
# процента его максимального HP одним ударом, урон урезается
# до этого процента (защита от ваншотов боссами на нестандартном
# контенте). 0 = выключено.
EchoBalance.MaxHitPercent = 0

# Урон боссов (rank 3) дополнительно умножается на этот множитель
# (сверху WorldDamageScalar).
EchoBalance.BossDamageScalar = 1.0

# Жетоны: доп. награда за завершение кампании (дублируется Lua
# в 00_CampaignRegistry -> balance.campaign_completion_tokens;
# если модуль включён и значение > 0 — использовать значение модуля).
EchoBalance.CampaignCompletionTokens = 3
